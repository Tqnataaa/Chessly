@using Microsoft.AspNetCore.Identity
@using Chessly.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <li class="nav-item">    
        <span class="nav-elem-elo"> @currentUser.UserName's Elo: @currentUser.Elo</span>
    </li>
    <li class="nav-item">
        <a class="nav-link chessly-nav-link d-flex align-items-center py-1" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Profile">
            <img src="~/img/Pictures/defaultPfp.png" 
                 asp-append-version="true" 
                 alt="Profile Picture" 
                 class="rounded-circle" 
                 style="width: 34px; height: 34px; object-fit: cover; border: 2px solid #f37324;" />
        </a>
    </li>
    <li class="nav-item ms-1">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link chessly-nav-link text-start">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link chessly-nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link chessly-nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>