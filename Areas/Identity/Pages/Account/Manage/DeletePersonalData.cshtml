@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </p>
</div>

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }
        <button class="w-100 btn btn-lg btn-danger" type="submit">Delete data and close my account</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
/* Constrain Delete Personal Data content width inside the Manage panel */
main:has(form#delete-user) .col-md-9 .alert-warning,
main:has(form#delete-user) .col-md-9 > div:has(form#delete-user) {
    max-width: 520px;
}

/* Dark-themed Danger Warning Callout */
main:has(form#delete-user) .alert-warning {
    background-color: rgba(255, 107, 107, 0.12);
    border: 1px solid #ff6b6b;
    border-left: 4px solid #ff6b6b;
    border-radius: 6px;
    color: #ffd6d6;
    padding: 16px 20px;
    margin-bottom: 24px;
    line-height: 1.55;
}

main:has(form#delete-user) .alert-warning p {
    margin-bottom: 0;
    font-size: 0.95rem;
}

main:has(form#delete-user) .alert-warning strong {
    color: #ff6b6b;
    font-weight: 700;
}

/* Form Spacing & Password Input Focus */
form#delete-user .form-floating {
    margin-bottom: 20px !important;
}

form#delete-user .form-floating > .form-control:focus {
    border-color: #ff6b6b;
    box-shadow: 0 0 0 0.2rem rgba(255, 107, 107, 0.2);
}

form#delete-user .form-floating > .form-control:focus ~ label,
form#delete-user .form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: #ff6b6b;
}

/* Refined Destructive Submit Button */
form#delete-user button[type="submit"] {
    width: auto !important;
    min-width: 260px;
    background-color: #dc3545;
    border: 1px solid #ff6b6b;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 24px;
    border-radius: 6px;
    margin-top: 4px;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

form#delete-user button[type="submit"]:hover {
    background-color: #b02a37;
    border-color: #ff8787;
}

form#delete-user button[type="submit"]:active {
    transform: translateY(1px);
}
</style>
