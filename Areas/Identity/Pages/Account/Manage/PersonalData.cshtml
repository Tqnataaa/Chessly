@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
        <p>
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Download</button>
        </form>
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Delete</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style> 
    /* Constrain content width inside the Manage panel */
main:has(form#download-data) .col-md-6 {
    max-width: 520px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
}

/* Full-width paragraphs above the buttons */
main:has(form#download-data) .col-md-6 > p:first-of-type {
    flex-basis: 100%;
    color: #d1d5db;
    line-height: 1.6;
    margin-bottom: 4px;
}

/* Dark Crimson Callout for the Permanent Deletion Warning */
main:has(form#download-data) .col-md-6 > p:nth-of-type(2) {
    flex-basis: 100%;
    background-color: rgba(255, 107, 107, 0.12);
    border: 1px solid #ff6b6b;
    border-left: 4px solid #ff6b6b;
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 12px;
    line-height: 1.5;
}

main:has(form#download-data) .col-md-6 > p:nth-of-type(2) strong {
    color: #ff6b6b;
    font-weight: 700;
}

/* Align Download Form & Delete Link Side-by-Side */
form#download-data {
    margin: 0;
}

main:has(form#download-data) .col-md-6 > p:last-of-type {
    margin: 0;
}

/* Download Button (Matches Chessly Orange) */
form#download-data button[type="submit"] {
    min-width: 140px;
    padding: 10px 22px;
    font-size: 0.9rem;
}

/* Delete Button */
a#delete.btn-danger {
    min-width: 140px;
    background-color: #dc3545;
    border: 1px solid #ff6b6b;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 22px;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

